rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (getUserData() != null && (getUserData().role == 'ADMIN' || getUserData().role == 'SUPER_ADMIN')) ||
        request.auth.token.email == 'yombivictor@gmail.com'
      );
    }
    
    function isContentManager() {
      return isAuthenticated() && (
        (getUserData() != null && (getUserData().role == 'ADMIN' || getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'CONTENT_MANAGER')) ||
        request.auth.token.email == 'yombivictor@gmail.com'
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'MEMBER'
                    && request.resource.data.membershipStatus == 'PENDING';
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.membershipStatus == resource.data.membershipStatus
      );
      allow delete: if isAdmin();
    }

    match /entrepreneurs/{entrepreneurId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == request.resource.data.ownerId || isAdmin());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource == null || resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow create: if true 
                    && request.resource.data.paymentStatus == 'PENDING'
                    && request.resource.data.donationStatus == 'PENDING';
      allow read: if isAdmin() || (isAuthenticated() && resource.data.donorUserId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // New CMS Rules
    match /articles/{articleId} {
      allow read: if resource == null || resource.data.status == 'PUBLISHED' || isContentManager();
      allow write: if isContentManager();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isContentManager();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isContentManager();
    }
    
    match /comments/{commentId} {
      allow read: if resource == null || resource.data.status == 'APPROVED' || isContentManager();
      allow create: if true; // anyone can comment
      allow update, delete: if isContentManager();
    }
    
    match /albums/{albumId} {
      allow read: if resource == null || resource.data.status == 'PUBLISHED' || isContentManager();
      allow write: if isContentManager();
    }
    
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isContentManager();
    }
    // Event Management Rules
    match /events/{eventId} {
      allow read: if resource == null || resource.data.status in ['PUBLISHED', 'REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'ONGOING', 'COMPLETED'] || isAdmin();
      allow write: if isAdmin();
    }

    match /eventRegistrations/{registrationId} {
      // Admins can read all. Members can read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // Anyone can register (including guests)
      allow create: if true
                    // Cannot fake payment success
                    && request.resource.data.paymentStatus in ['PENDING', 'NOT_REQUIRED']
                    // Cannot fake attendance
                    && (!('attended' in request.resource.data) || request.resource.data.attended == false)
                    // Cannot set status to anything other than REGISTERED or WAITLISTED
                    && request.resource.data.status in ['REGISTERED', 'WAITLISTED'];
                    
      // Members can only cancel their own registrations, admins can do anything
      allow update: if isAdmin() || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid 
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                     && request.resource.data.status == 'CANCELLED');
                     
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true; // Public verification
      allow write: if isAdmin();
    }

    // Memberships Rules
    match /memberships/{membershipId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status in ['PENDING', 'AWAITING_PAYMENT'];
      allow update: if isAdmin() || (
                      isAuthenticated() && resource.data.userId == request.auth.uid 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bankReference', 'proofUrl', 'updatedAt'])
                      && (request.resource.data.status == 'PAYMENT_SUBMITTED' || request.resource.data.status == 'CANCELLED')
                    );
      allow delete: if isAdmin();
    }

    // Visual & Structured CMS Rules
    match /cms/{documentId} {
      allow read: if true;
      allow write: if isContentManager() || isAdmin();
    }

    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isContentManager() || isAdmin();
    }

    match /cms_history/{historyId} {
      allow read: if isContentManager() || isAdmin();
      allow create: if isContentManager() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /cms_audit_logs/{logId} {
      allow read: if isContentManager() || isAdmin();
      allow create: if isContentManager() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // MARKETPLACE
    // ==========================================
    match /marketplace_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // User can read their own orders. Admins can read all.
      // Guest orders should probably be accessed with a special mechanism or just via email/ref, but for now we allow authenticated users to read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // Anyone can create an order
      allow create: if true;
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }
  }
}
